# Salin file ini menjadi .env bila ingin mengganti default.
# Tidak ada kredensial di sini: tiap run mendaftarkan akun bot baru sendiri.
BASE_URL=https://staging-tools.eiklab.com

# Jeda sebelum/sesudah screenshot langkah (ms)
SNAP_PAUSE_BEFORE_MS=800
SNAP_PAUSE_AFTER_MS=400

# Isi CV (create & edit) dari Gemini. Kosongkan key untuk memakai data dummy lokal (faker).
GEMINI_API_KEY=
# on (default) = konten dari Gemini; off = selalu pakai data dummy (lebih cepat)
AI_MODE=on
